  "query": "\n        SELECT id, bank_id, created_at, duration_ms, items_count,\n               index_text_caller_supplied, error\n        FROM retain_events\n        WHERE ($1::text IS NULL OR bank_id = $1)\n        ORDER BY created_at DESC\n        LIMIT $2\n        ",
