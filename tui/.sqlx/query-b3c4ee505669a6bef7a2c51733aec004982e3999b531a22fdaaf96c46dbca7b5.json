  "query": "\n        SELECT id, bank_id, started_at, duration_ms,\n               files_seen, files_indexed, files_pruned, errors_count, corpus_path\n        FROM sweep_passes\n        WHERE ($1::text IS NULL OR bank_id = $1)\n        ORDER BY started_at DESC\n        LIMIT $2\n        ",
