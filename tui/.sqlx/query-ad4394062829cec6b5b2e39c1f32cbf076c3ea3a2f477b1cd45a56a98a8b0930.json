{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            d.id,\n            d.bank_id,\n            d.source,\n            d.content_hash,\n            d.tags,\n            d.created_at,\n            (SELECT count(*) FROM memory_items mi WHERE mi.document_id = d.id) AS item_count\n        FROM documents d\n        WHERE d.bank_id = $1\n        ORDER BY d.created_at DESC, d.id\n        LIMIT $2 OFFSET $3\n        ",
