  "query": "\n        SELECT id, bank_id, created_at, duration_ms, mode, n_results,\n               synthesis IS NOT NULL AS has_synth\n        FROM recall_events\n        WHERE ($1::text IS NULL OR bank_id = $1)\n        ORDER BY created_at DESC\n        LIMIT $2\n        ",
