  "query": "\n        SELECT id, bank_id, created_at, duration_ms, prompt_name, error\n        FROM llm_calls\n        WHERE ($1::text IS NULL OR bank_id = $1)\n        ORDER BY created_at DESC\n        LIMIT $2\n        ",
